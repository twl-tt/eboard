datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(TEACHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String
  grade     String
  articles  Article[]
  createdAt DateTime  @default(now())

  @@unique([name, grade])
}

model Article {
  id          String    @id @default(uuid())
  title       String
  rawContent  String    @db.Text
  translation String?   @db.Text
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sentences   Json
  highlights  Json      @default("[]")
  canvasState Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
}

model Student {
  id        String     @id @default(uuid())
  name      String
  seatNo    Int?
  className String?    @map("class")
  group     String?
  points    Int        @default(0)
  scoreLogs ScoreLog[]
  createdAt DateTime   @default(now())

  @@index([className])
  @@index([group])
}

model ScoreLog {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  @@index([studentId])
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUEFALSE
  SHORTANSWER
  MATCHING
}

model Poll {
  id            String        @id @default(uuid())
  question      String
  isActive      Boolean       @default(true)
  questionType  QuestionType?
  correctIndex  Int?
  correctAnswer String?
  explanation   String?       @db.Text
  isQuiz        Boolean       @default(false)
  options       PollOption[]
  answers       QuizAnswer[]
  createdAt     DateTime     @default(now())

  @@index([isQuiz, createdAt])
}

model PollOption {
  id            String  @id @default(uuid())
  pollId        String
  poll          Poll    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text          String
  votes         Int     @default(0)
  questionIndex Int     @default(0)
  questionText  String?
  optionIndex   Int     @default(0)
  isCorrect     Boolean @default(false)
  explanation   String?
  answers       QuizAnswer[]

  @@index([pollId, questionIndex, optionIndex])
}

model QuizAnswer {
  id            String     @id @default(uuid())
  pollId        String
  poll          Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  voterId       String     @db.Uuid
  questionIndex Int
  optionId      String
  option        PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([pollId, voterId, questionIndex])
  @@index([optionId])
}

model WordCloud {
  id          String      @id @default(uuid())
  title       String
  words       WordCloudEntry[]
  isActive    Boolean     @default(true)
  multiSubmit Boolean     @default(true)
  createdAt   DateTime    @default(now())
}

model WordCloudEntry {
  id          String   @id @default(uuid())
  wordCloudId String
  wordCloud   WordCloud @relation(fields: [wordCloudId], references: [id], onDelete: Cascade)
  text        String
  count       Int      @default(1)
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  category  String
  color     String   @default("violet")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([name, category])
  @@index([category])
}
